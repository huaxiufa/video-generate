AGNES_BASE_URL=https://apihub.agnes-ai.com
# Agnes API keys: prefer numbered variables in Docker .env
# AGNES_API_KEY_1=key1
# AGNES_API_KEY_2=key2
AGNES_API_KEY=
AGNES_IMAGE_MODEL=agnes-image-2.5-flash
AGNES_TEXT_MODEL=agnes-3.0-flash
# Switch video engine without changing the project:
#   agnes-video-2.5-flash = modern 2.5 keyframe protocol
#   agnes-video-2.5       = modern 2.5 protocol
#   agnes-video-v2.0      = legacy v2.0 protocol
AGNES_VIDEO_MODEL=agnes-video-2.5-flash
GEMINI_API_KEY=
GEMINI_TTS_MODEL=gemini-3.1-flash-tts-preview
GEMINI_TTS_VOICE=Kore
MOSS_TTS_REPO=/opt/MOSS-TTS-Nano
MOSS_TTS_MODEL_DIR=/data/moss-models
MOSS_TTS_EXECUTION_PROVIDER=cpu
MOSS_TTS_CPU_THREADS=4
WORK_DIR=/data/projects
