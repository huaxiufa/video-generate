AGNES_API_KEY=
GEMINI_API_KEY=
# Gemini TTS: 3.1 Flash / 2.5 Flash / 2.5 Pro
GEMINI_TTS_MODEL=gemini-3.1-flash-tts-preview
GEMINI_TTS_VOICE=Kore
# MOSS-TTS-Nano ONNX CPU. Leave blank to use its automatic model directory.
MOSS_TTS_ONNX_MODEL_DIR=
MOSS_TTS_CPU_THREADS=4
NA_VOICE_DIR=/app/agnes_data/voices

# Agnes video 503 recovery. Keyframe gets a longer retry window; no model fallback is automatic.
AGNES_VIDEO_KEYFRAME_MAX_RETRIES=10
AGNES_VIDEO_503_MAX_DELAY=180
