AGNES_BASE_URL=https://apihub.agnes-ai.com/v1
AGNES_API_KEY=
AGNES_VIDEO_MODEL=agnes-video-2.5-flash
# 可选：agnes-video-2.5 / agnes-video-2.5-flash / agnes-video-v2.0；网页侧栏也可直接切换。

GEMINI_API_KEY=
GEMINI_TTS_MODEL=gemini-3.1-flash-tts-preview
# 可选：gemini-2.5-flash-preview-tts / gemini-2.5-pro-preview-tts；网页侧栏也可直接切换。
COSYVOICE_BASE_URL=http://localhost:8080
# 可选：CosyVoice 3 自托管 API。Gemini首句+CosyVoice续配音模式下，每个角色只首次调用 Gemini，后续对白使用已注册的角色声音。
