AGNES_BASE_URL=https://apihub.agnes-ai.com/v1
AGNES_API_KEY=
AGNES_VIDEO_MODEL=agnes-video-2.5-flash
# 可选：agnes-video-2.5 / agnes-video-2.5-flash / agnes-video-v2.0；网页侧栏也可直接切换。

GEMINI_API_KEY=
GEMINI_TTS_MODEL=gemini-3.1-flash-tts-preview
# 可选：gemini-2.5-flash-preview-tts / gemini-2.5-pro-preview-tts；网页侧栏也可直接切换。

MOSS_TTS_COMMAND=python -m moss_tts_nano.cli
# 使用 INT8 ONNX：约 198MB 的 TTS LM；首次运行自动从 Hugging Face 下载。
MOSS_TTS_ONNX_MODEL_DIR=/app/models/MOSS-TTS-Nano-100M-ONNX-int8
MOSS_TTS_CPU_THREADS=4
MOSS_TTS_INT8_REPO=REALBITS/MOSS-TTS-Nano-100M-ONNX-int8
MOSS_TTS_CODEC_REPO=OpenMOSS-Team/MOSS-Audio-Tokenizer-Nano-ONNX
# MOSS-TTS-Nano 使用 ONNX CPU 做后续角色对白的零样本音色克隆；首次角色声音由 Gemini 生成并保存到 audio/voices/。
